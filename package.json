{
  "name": "metro-telecom",
  "version": "1.0.0",
  "description": "Metro Telecom - Professional POS & Stock Management Desktop Application",
  "main": "main.js",
  "author": "Shahin <shahin0964>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:web": "node -e \"const fs=require('fs'); fs.mkdirSync('www', {recursive:true}); ['index.html','style.css','app.js','icon.png'].forEach(f=>{if(fs.existsSync(f))fs.copyFileSync(f, 'www/'+f)});\"",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.metro.telecom",
    "productName": "Metro Telecom",
    "copyright": "Copyright © 2026 Metro Telecom",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.github/**",
      "!*.md",
      "!metro_flutter_app/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metro Telecom",
      "artifactName": "Metro-Telecom-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Metro-Telecom-Portable-${version}.${ext}"
    }
  }
}
